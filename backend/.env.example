# --- Server ---
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# --- Database (Postgres) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reachinbox

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Session ---
SESSION_SECRET=change-this-to-a-long-random-string

# --- Google OAuth ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# --- Queue / rate limiting (all configurable, nothing hardcoded) ---
# How many jobs the worker processes in parallel.
WORKER_CONCURRENCY=5
# Minimum gap enforced between ANY two email sends, globally, via BullMQ's limiter.
MIN_DELAY_BETWEEN_EMAILS_MS=2000
# Default per-sender hourly cap used when a batch doesn't specify its own.
DEFAULT_MAX_EMAILS_PER_HOUR_PER_SENDER=100
# On boot, re-enqueue any DB jobs missing from the live BullMQ queue.
RECONCILE_ON_BOOT=true
# Run the BullMQ worker inside the API process (handy for local dev).
# Set to "false" and run `npm run worker` separately in production.
RUN_WORKER_IN_PROCESS=true

# How many fake Ethereal senders `npm run seed` creates.
SEED_SENDER_COUNT=3
